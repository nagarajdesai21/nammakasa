# NammaKasa Mobile App Configuration
# Copy this to .env and update values

# API Configuration
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# For production, use actual IP:
# EXPO_PUBLIC_API_URL=http://YOUR_LAPTOP_IP:5000

# Testing
EXPO_PUBLIC_USE_MOCK_OTP=true

# MSG91 SMS Gateway (when ready to implement)
# EXPO_PUBLIC_MSG91_API_KEY=your_api_key_here
